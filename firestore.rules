rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /complaints/{document=**} {
      allow read, write: if true;
    }
    match /projects/{document=**} {
      allow read, write: if true;
    }
    match /ledger/{document=**} {
      allow read, write: if true;
    }
    match /settings/{document=**} {
      allow read, write: if true;
    }
    match /counters/{document=**} {
      allow read, write: if true;
    }
  }
}


